# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://reap:reap@localhost:5432/reap
# Public base URL of the site (used in SMS/email links, payment callbacks)
APP_URL=http://localhost:3000
# 32+ random characters. Used to encrypt 2FA secrets and sign tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Protects /api/cron/* endpoints (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=change-me-too
# DATABASE_SSL=true
# DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Messaging — leave blank to run in "log" mode (messages recorded, not sent)
# ---------------------------------------------------------------------------
# SMS: twilio | africastalking | log
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# WhatsApp: meta | twilio | log
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token you choose; must match the one entered in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app secret, used to verify X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=

# Email: smtp | resend | log
EMAIL_PROVIDER=log
EMAIL_FROM="REAP <no-reply@example.org>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Payments — manual methods (cash, Orange Money, bank) always work
# ---------------------------------------------------------------------------
# MTN Mobile Money (Collections API)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CURRENCY=EUR
# Flutterwave (cards)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ---------------------------------------------------------------------------
# Social publishing — leave blank to use "share manually" mode
# ---------------------------------------------------------------------------
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
X_ACCESS_TOKEN=
